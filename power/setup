#!/usr/bin/env bash

sudo ln -sf $PWD/powermode /usr/local/bin/powermode

sudo cp $PWD/powermode-restore.service /etc/systemd/system/.
sudo systemctl daemon-reload

# cpufrequtils forces its own governor at boot and fights powermode
sudo systemctl disable --now cpufrequtils.service 2>/dev/null || true
sudo systemctl mask cpufrequtils.service

sudo systemctl enable powermode-restore.service
